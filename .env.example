# ==================== nowen-video 环境变量示例 ====================
# 复制此文件为 .env 并修改其中的值：
#   cp .env.example .env
#
# 在 docker-compose.yml 所在目录创建 .env 后，
# Docker Compose 会自动加载其中的环境变量。

# ---- PostgreSQL 密码（docker-compose.yml 中 postgres 服务使用）----
# PG_PASSWORD=nowen_password

# ---- PostgreSQL 模式环境变量（取消注释，同时注释 docker-compose.yml 中 NOWEN_DATABASE_DB_PATH）----
# NOWEN_DATABASE_DRIVER=postgresql
# NOWEN_DATABASE_HOST=postgres
# NOWEN_DATABASE_PORT=5432
# NOWEN_DATABASE_USER=postgres
# NOWEN_DATABASE_PASSWORD=nowen_password
# NOWEN_DATABASE_DBNAME=nowen_video
# NOWEN_DATABASE_SSLMODE=disable

# ---- JWT Secret（生产环境强烈建议设置）----
# 生成方法: openssl rand -base64 32
# NOWEN_SECRETS_JWT_SECRET=your-own-strong-random-secret
