# ==================== nowen-video 环境变量模板 ====================
# 复制为 .env.dev / .env.prod 使用：
#   cp .env.example .env.dev     # 开发
#   cp .env.example .env.prod    # 生产（⚠️ .env.prod 不入 git）
#
# 启动：
#   make dev                 # 用 .env.dev
#   make prod                # 用 .env.prod
#   make dev OPTS=-d         # 后台运行
#
# ⚠️ 哪些变量真正生效（env 能覆盖 config 的情况）：
#   env 只能覆盖【config.yaml 主文件里写的】或【config/ 分片里没写/为空的】字段。
#   被 config/*.yaml 分片文件占住的（database、ai、app.port、logging.level），
#   env 一律无效——改那些请直接编辑对应的 config/*.yaml。
# ============================================================

# ==================== 日志级别 ====================
# App.Debug 决定日志：true=DEBUG 级(zap.NewDevelopment)，false=info 级。
#   - dev 环境通常设 true（看详细日志）
#   - prod 留空/不设（默认 false=info）
NOWEN_DEBUG=false

# ==================== 功能开关 ====================
# 视频分析（Scene/Structure 场景检测，默认开）
# NOWEN_VIDEO_ANALYSIS_ENABLED=true
# 结构化产物数据目录（staging 搬移后的持久位置，与 staging 同文件系统）
# NOWEN_VIDEO_ANALYSIS_ASSET_DIR=/data/video-structure
# 番号刮削（默认关）
# NOWEN_ADULT_SCRAPER_ENABLED=false

# ==================== JWT Secret ====================
# 留空：程序自动生成 32 字节随机值并持久化到 /app/data/.jwt_secret（重启不失效）。
# 生产强烈建议显式设置：
#   openssl rand -base64 32
# NOWEN_SECRETS_JWT_SECRET=your-own-strong-random-secret

# ==================== Alpine 镜像源（构建加速，可选）====================
# Dockerfile/Dockerfile.dev 里 apk 的镜像源，默认阿里云，无需配置；
# 换源：make build ALPINE_MIRROR=...（生产）或 docker compose build --build-arg ALPINE_MIRROR=...（dev）

# ==================== 数据库（改这 → 去 config/database.yaml）====================
# env 无效：database.yaml 是分片文件，会覆盖 NOWEN_DATABASE_*。
# 修改数据库连接请编辑 config/database.yaml：
#   host / port / user / password / dbname / sslmode
#
# 仅当使用【自包含部署】（启用 docker-compose.yml 里注释的内置 postgres 服务）时，
# 用 env 指向内置库：
# PG_PASSWORD=nowen_password
# NOWEN_DATABASE_HOST=postgres
# NOWEN_DATABASE_PORT=5432
# NOWEN_DATABASE_USER=postgres
# NOWEN_DATABASE_PASSWORD=nowen_password
# NOWEN_DATABASE_DBNAME=nowen_video
# NOWEN_DATABASE_SSLMODE=disable

# ==================== AI 配置（改这 → 去 config/ai.yaml）====================
# env 无效：ai.yaml 是分片文件，会覆盖 NOWEN_AI_*。
# 修改 LLM 请编辑 config/ai.yaml：
#   provider / api_base / model / api_key / profiles.* / scene_describe_ai
# 注意：ai.yaml 里的 api_base 需容器可达，本机服务用 172.17.0.1:PORT 而非 0.0.0.0

# ==================== 端口（改这 → 去 config/app.yaml）====================
# env 无效：app.yaml 是分片文件，会覆盖 NOWEN_APP_PORT。
# 修改监听端口请编辑 config/app.yaml 的 port（当前 38080），
# 并同步 docker/docker-compose.yml 的 ports 映射。
