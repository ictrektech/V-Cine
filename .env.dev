# ==================== nowen-video 开发环境 ====================
# 用法: docker compose --env-file .env.dev up -d
#
# 本文件只放【真正生效】的 env 开关。注意：
#   - 被 config/*.yaml 写死的值，env 无法覆盖（加载器 mergeConfigDir 会用
#     viper.Set 强写分片文件的值，把 env 顶掉）。
#   - AI 配置（api_base/model/provider/key）一律看 config/ai.yaml，env 无效。
#   - 数据库看 config/database.yaml，env 无效。
# ============================================================

# ---- Debug 开关 → 日志级别（dev=debug，默认 info）----
NOWEN_DEBUG=true

# ---- 功能开关（config.yaml 里有的可被 env 覆盖；config/ 分片里的则不可）----
NOWEN_VIDEO_ANALYSIS_ENABLED=true
NOWEN_ADULT_SCRAPER_ENABLED=false

# ---- JWT Secret（留空：程序自动生成并持久化到 /app/data/.jwt_secret）----
# NOWEN_SECRETS_JWT_SECRET=

# ---- 数据库：连外部库，走 config/database.yaml，无需在此配 ----
#     host=10.144.144.232 port=35432 user=postgres dbname=nowen_video
