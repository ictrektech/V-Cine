#!/usr/bin/env bash
# 发布决策（在所有 profile 镜像已构建、推送并登记飞书之后执行）：
#   bump ictrek.app/VERSION → commit → 推分支 → 打 VOS 触发 tag 并推送（触发 CI 上架）
#
# 与构建解耦：镜像 tag 为 <平台>_<日期>_<githash>，由 build_image.sh 生成并写飞书；
# package.sh 打包时从飞书读取各 profile 最新 tag。构建失败直接重跑 build_image.sh，
# 不会产生悬空的版本号提交。
#
# 用法：
#   ./update_version [patch|minor|major]
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
exec ./ictrek.app/scripts/update_version.sh "$@"
