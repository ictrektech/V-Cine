# =============================================
# 开发专用镜像（NVIDIA x86 · CUDA 12.8 + jellyfin-ffmpeg7 + Go + Air）
# 用于本地验证 NVENC / CUDA 硬件加速；与生产 docker/Dockerfile 保持同一套 FFmpeg。
# 非 NVIDIA 开发机暂不适用；后续如需通用 dev 镜像再单独维护。
# 构建：make dev-build（或 docker build -f docker/Dockerfile.dev .）
# =============================================

# 阶段1: 取 Go 工具链（alpine 版 Go 为静态二进制，可拷到 Ubuntu 基座使用）
FROM golang:1.25-alpine AS golang

# 阶段2: 开发/运行环境（与生产同基座，便于硬件加速行为一致）
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04

# Go 模块代理：避免构建时直连 proxy.golang.org 超时；可用 --build-arg GOPROXY=... 覆盖。
ARG GOPROXY=https://goproxy.cn,https://goproxy.io,direct
ENV GOPROXY=${GOPROXY}
ENV GOROOT=/usr/local/go
ENV GOPATH=/go
# 容器内挂载宿主 git 仓库时，Go 默认 buildvcs 会因 git dubious ownership 失败；dev 不需要 VCS 信息
ENV GOFLAGS=-buildvcs=false
ENV PATH="${GOROOT}/bin:${GOPATH}/bin:${PATH}"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

COPY --from=golang /usr/local/go /usr/local/go

# 保持与 golang 官方镜像一致的 GOPATH 布局（docker-compose.dev.yml 挂载 /go/pkg/mod）
RUN mkdir -p /go/bin /go/pkg/mod && chmod -R 777 /go

# ---- 国内 Ubuntu 镜像加速（默认阿里云；--build-arg UBUNTU_MIRROR= 可关闭）----
# 同时兼容 /etc/apt/sources.list 与 Deb822 的 ubuntu.sources
ARG UBUNTU_MIRROR=https://mirrors.aliyun.com/ubuntu
ARG JELLYFIN_REPO=https://mirror.nju.edu.cn/jellyfin/ubuntu
ARG JELLYFIN_KEY_URL=https://repo.jellyfin.org/jellyfin_team.gpg.key
RUN set -eux; \
    if [ -n "${UBUNTU_MIRROR}" ]; then \
        find /etc/apt -maxdepth 2 -type f \( -name 'sources.list' -o -name '*.sources' \) \
            -exec sed -i \
                -e "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
                -e "s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
                -e "s|https://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
                -e "s|https://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
                {} +; \
    fi

# ---- 系统依赖 + Jellyfin 镜像仓库 + jellyfin-ffmpeg7 + Python 刮削 + 诊断工具 ----
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        wget \
        tzdata \
        git \
        gosu \
        coreutils \
        python3 \
        python3-pip \
        python3-flask \
        python3-requests \
        python3-bs4 \
        python3-lxml \
        mesa-va-drivers \
        vainfo \
        libva2 \
        libva-drm2; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL "${JELLYFIN_KEY_URL}" | gpg --dearmor -o /etc/apt/keyrings/jellyfin.gpg; \
    chmod 644 /etc/apt/keyrings/jellyfin.gpg; \
    printf 'Types: deb\nURIs: %s\nSuites: jammy\nComponents: main\nArchitectures: amd64 arm64\nSigned-By: /etc/apt/keyrings/jellyfin.gpg\n' "${JELLYFIN_REPO}" > /etc/apt/sources.list.d/jellyfin.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends jellyfin-ffmpeg7; \
    ln -sf /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/bin/ffmpeg; \
    ln -sf /usr/lib/jellyfin-ffmpeg/ffprobe /usr/bin/ffprobe; \
    if ! ffmpeg -hide_banner -encoders | grep -q "h264_nvenc"; then \
        echo "ERROR: jellyfin-ffmpeg missing h264_nvenc (NVIDIA x86 dev 需要 NVENC)" >&2; exit 1; \
    fi; \
    rm -rf /var/lib/apt/lists/*; \
    git config --global --add safe.directory '*'

# ---- Air：监听源码变化并自动重编译/重启 Go 服务 ----
ARG AIR_VERSION=v1.63.0
RUN GOBIN=/usr/local/bin go install github.com/air-verse/air@${AIR_VERSION}

WORKDIR /app
